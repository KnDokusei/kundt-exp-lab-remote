From ddb0765d3e3acbc9c15e17afd11d7f792d6dc59a Mon Sep 17 00:00:00 2001
From: MATIAS <mnpn31@gmail.com>
Date: Thu, 1 Oct 2026 17:23:52 -0300
Subject: [PATCH 1/5] fix: create the RTSP server only once

---
 src/main.cpp | 11 +++++++++--
 1 file changed, 9 insertions(+), 2 deletions(-)

diff --git a/src/main.cpp b/src/main.cpp
index 1e30441..a1ee76d 100644
--- a/src/main.cpp
+++ b/src/main.cpp
@@ -334,8 +334,15 @@ void update_camera_settings()
 void start_rtsp_server()
 {
   log_v("start_rtsp_server");
-  camera_server = std::unique_ptr<rtsp_server>(new rtsp_server(cam, param_frame_duration.value(), RTSP_PORT));
-  // Add RTSP service to mDNS
+  // [local kundt] Create the server only once. IotWebConf calls on_connected()
+  // on every Wi-Fi reconnection; re-creating it made the new server fail to
+  // listen (the old one still held port 554) and then the old one was deleted,
+  // closing the port: RTSP stayed dead until the next reboot. The listening
+  // socket is bound to any address, so it survives reconnections, like the
+  // web server on port 80.
+  if (!camera_server)
+    camera_server = std::unique_ptr<rtsp_server>(new rtsp_server(cam, param_frame_duration.value(), RTSP_PORT));
+  // Add RTSP service to mDNS (IotWebConf restarts mDNS on every reconnection)
   // HTTP is already set by iotWebConf
   MDNS.addService("rtsp", "tcp", RTSP_PORT);
 }
