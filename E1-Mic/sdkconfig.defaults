# Target
CONFIG_IDF_TARGET="esp32"

# 4 MB flash on the DOIT DEVKIT V1
CONFIG_ESPTOOLPY_FLASHSIZE_4MB=y

# The streaming task must not be starved; keep both watchdogs on so a stall
# is reported rather than silently degrading the audio.
CONFIG_ESP_TASK_WDT_INIT=y
CONFIG_ESP_TASK_WDT_CHECK_IDLE_TASK_CPU0=y
CONFIG_ESP_TASK_WDT_CHECK_IDLE_TASK_CPU1=y

# 44.1 kHz * 2 bytes = ~88 KiB/s sustained over TCP; give lwIP room so the
# ADC pool does not overflow while the stack drains.
CONFIG_LWIP_TCP_SND_BUF_DEFAULT=16384
CONFIG_LWIP_TCP_WND_DEFAULT=16384

# Keep the default log level informative but not chatty in the hot path.
CONFIG_LOG_DEFAULT_LEVEL_INFO=y

# Dos particiones OTA: ver partitions.csv. La tabla personalizada sustituye a la
# de app único, que dejaba los binarios al 90% de ocupación.
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"

# Una imagen recién grabada arranca a prueba: si no se confirma, el siguiente
# reinicio vuelve a la anterior. Es la red que evita dejar una placa inservible
# dentro del montaje.
CONFIG_BOOTLOADER_APP_ROLLBACK_ENABLE=y
