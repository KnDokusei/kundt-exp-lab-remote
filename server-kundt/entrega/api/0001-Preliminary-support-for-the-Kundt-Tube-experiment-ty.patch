+    /*
+     * Kundt tube. Three independent modules publish to the same topic, each one
+     * sending only the fields it owns, so this merges instead of replacing:
+     * writing `undefined` into a Prisma `update` leaves the column untouched,
+     * which is exactly the behaviour needed here. Spreading the whole payload
+     * would let E1 blank out the values E3 just reported.
+     */
+    async updateKundtStatus(payload: KundtMQTT)
+    {
+        //TODO: Assert/Exception managment
+        let controller_id = payload.device.id;
+        const exp_entry = await this.prisma.expBase.findUnique({
+            where: {
+                controller_id: controller_id
+            }
+        });
+
+        const updated_entry = await this.prisma.kundt.update({
+            where: {
+                id: exp_entry!.id
+            },
+            data: {
+                frequency:       payload.actuators?.frequency,
+                volume:          payload.actuators?.volume,
+                plunger_pos:     payload.actuators?.plunger_pos,
+                mic_amplitude:   payload.sensors?.mic_amplitude,
+                mic_rms:         payload.sensors?.mic_rms,
+                mic_peak:        payload.sensors?.mic_peak,
+                plunger_actual:  payload.sensors?.plunger_actual,
+                clockwise_limit: payload.sensors?.clockwise_limit,
+                counter_limit:   payload.sensors?.counter_limit,
+            }
+        })
+
+        console.log("[Kundt] UPDATED_ENTRY: ", updated_entry);
+
+        this.eventEmitter.emit('kundt-update', updated_entry);
+    }
