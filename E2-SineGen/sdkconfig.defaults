# Target: DOIT ESP32 DEVKIT V1
CONFIG_IDF_TARGET="esp32"
CONFIG_ESPTOOLPY_FLASHSIZE_4MB=y

CONFIG_LOG_DEFAULT_LEVEL_INFO=y

# Dos particiones OTA: ver partitions.csv. La tabla personalizada sustituye a la
# de app único, que dejaba los binarios al 90% de ocupación.
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"

# Una imagen recién grabada arranca a prueba: si no se confirma, el siguiente
# reinicio vuelve a la anterior. Es la red que evita dejar una placa inservible
# dentro del montaje.
CONFIG_BOOTLOADER_APP_ROLLBACK_ENABLE=y

# esp_https_ota() rechaza las URL http:// salvo que esto este activado, y lo
# hace antes de tocar la red: el modulo descarta la orden en silencio y sigue
# como si nada. La imagen viaja por la LAN del laboratorio desde un servidor
# efimero en el PC, sin certificado, asi que se permite HTTP plano.
CONFIG_ESP_HTTPS_OTA_ALLOW_HTTP=y
